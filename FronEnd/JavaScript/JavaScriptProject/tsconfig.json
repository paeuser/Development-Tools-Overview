{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",           // or "ESNext" if using "type": "module"
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
